module motor_calibration (
  clk_d,
  n7_6,
  n5007_6,
  calibration_request,
  control_reset_n,
  move_enable_6,
  n536_3,
  n537_3,
  n539_3,
  n3868_8,
  core_calibration_test,
  swing_count_31_16,
  emergency_stop_Z,
  actual_pwm,
  applied_pwm,
  raw_position,
  calibration_request_session,
  calibration_c,
  calibration_b,
  calibration_request_trial,
  a_q,
  b_q,
  calibration_kind,
  calibration_a,
  count,
  key_press,
  calibration_session,
  calibration_active,
  calibration_event,
  n113_7,
  n112_7,
  n111_7,
  n33609_5,
  n110_8,
  n114_9,
  calibration_ms,
  calibration_raw_counts,
  calibration_session_id,
  calibration_trial_id,
  calibration_phase,
  calibration_result,
  calibration_t_command,
  calibration_t_pwm,
  calibration_t_edge,
  calibration_t_end,
  calibration_start_position,
  calibration_end_position,
  calibration_window1,
  calibration_window2,
  calibration_window3
)
;
input clk_d;
input n7_6;
input n5007_6;
input calibration_request;
input control_reset_n;
input move_enable_6;
input n536_3;
input n537_3;
input n539_3;
input n3868_8;
input core_calibration_test;
input swing_count_31_16;
input emergency_stop_Z;
input [15:1] actual_pwm;
input [0:0] applied_pwm;
input [31:0] raw_position;
input [31:0] calibration_request_session;
input [31:0] calibration_c;
input [31:0] calibration_b;
input [15:0] calibration_request_trial;
input [15:0] a_q;
input [7:0] b_q;
input [2:0] calibration_kind;
input [31:0] calibration_a;
input [3:0] count;
input [3:3] key_press;
output calibration_session;
output calibration_active;
output calibration_event;
output n113_7;
output n112_7;
output n111_7;
output n33609_5;
output n110_8;
output n114_9;
output [31:0] calibration_ms;
output [15:0] calibration_raw_counts;
output [31:0] calibration_session_id;
output [15:0] calibration_trial_id;
output [2:0] calibration_phase;
output [3:0] calibration_result;
output [31:0] calibration_t_command;
output [31:0] calibration_t_pwm;
output [31:0] calibration_t_edge;
output [31:0] calibration_t_end;
