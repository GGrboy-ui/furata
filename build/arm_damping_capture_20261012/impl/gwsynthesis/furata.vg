module adc128s102_reader (
  clk_d,
  n7_6,
  board_adc_dout_d,
  n130_8,
  count,
  adc_valid,
  board_adc_sclk_d,
  board_adc_cs_n_d,
  busy_Z,
  divider_31_9,
  adc_data,
  state
